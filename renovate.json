{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Require dashboard approval before opening major upgrade PRs.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Automerge patch-level npm and pnpm updates once CI is green.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "npm patch updates",
      "automerge": true
    },
    {
      "description": "Group minor npm and pnpm updates into one PR for review.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "npm dependencies (minor)"
    },
    {
      "description": "Automerge patch-level GitHub Actions updates once CI is green.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "github actions patch updates",
      "automerge": true
    },
    {
      "description": "Group minor GitHub Actions updates into one PR for review.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor"],
      "groupName": "github actions (minor)"
    }
  ]
}
